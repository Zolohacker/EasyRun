HTTP_ADDR=:8080
DATABASE_URL=POSTGRES_DSN
POSTGRES_DB=easyrun
POSTGRES_USER=easyrun
POSTGRES_PASSWORD=CHANGE_ME_FOR_DOCKER
DATABASE_MAX_CONNS=12
DATABASE_MIN_CONNS=2
DATABASE_CONNECT_TIMEOUT=5s
MAP_API_BASE_URL=https://restapi.amap.com
MAP_API_PATH=/v3/direction/walking
MAP_API_KEY=YOUR_WEB_SERVICE_KEY
MAP_API_TIMEOUT=8s
MAP_API_QPS=3
MAP_API_BURST=2
MAP_API_MAX_RETRIES=2
MAP_API_CACHE_TTL=24h
MAP_API_CACHE_SIZE=5000
MAP_ROUTE_CANDIDATES=4
AUTOMATION_WORKERS=2
AUTOMATION_WORKER_CONCURRENCY=1
AUTOMATION_POLL_INTERVAL=10s
AUTOMATION_RUN_TIMEOUT=90m
ACCOUNT_MASTER_KEY=BASE64_ENCODED_32_BYTE_KEY
PROTOCOL_BASE_URL=https://api.huachenjie.com/run-front
PROTOCOL_WEB_BASE_URL=https://mh5.huachenjie.com
PROTOCOL_ENVIRONMENT=9
PROTOCOL_TIMEOUT=20s
# 首次远程初始化必须设置随机令牌；本机直连可留空。
PORTAL_SETUP_TOKEN=
# HTTPS 反向代理部署请设 true；本机 HTTP 保持 false。
COOKIE_SECURE=false
# 本机 Windows 可填 bin/face/libInspireFace.dll 和 bin/face/Megatron。
# Linux / Docker 使用 /app/models/libInspireFace.so 和 /app/models/Megatron。
# 默认留空，配置运行库和模型文件后同时填写两项。
FACE_ENGINE_LIBRARY_PATH=
FACE_MODEL_PACK_PATH=
FACE_DETECT_PIXEL_SIZE=320
